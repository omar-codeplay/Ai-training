ocation=\"cpu\", weights_only=False)\n    arch = (ck[\"filters\"], ck[\"blocks\"])\n    state = {k.replace(\"module.\", \"\"): v for k, v in ck[\"sd\"].items()}\n    net = ChessNet(*arch)\n    net.load_state_dict(state, strict=True)\n    half = bool(ck.get(\"fp16\")) if force_half is None else force_half\n    if half:\n        net = net.half()\n    return net.to(device=\"cuda\", memory_format=torch.channels_last).eval(), half\n\nCK = \"/kaggle/working/ckpt/best_v9.pt\"\nFK = \"/kaggle/working/ckpt/best_v9_fused_fp16.pt\"\nbb = torch.zeros(8, 12, device=\"cuda\", dtype=torch.int64)\nme = torch.zeros(8, 2, device=\"cuda\", dtype=torch.uint8)\nprint(\"%-7s %-5s %-9s %10s %10s %8s\" % (\"net\", \"dtype\", \"dP\", \"eager_us\", \"graph_us\", \"speedup\"))\nfor tag, path in ((\"source\", CK), (\"fused\", FK)):\n    if not os.path.isfile(path):\n        print(tag, \"MISSING\")\n        continue\n    net, half = build(path)\n    cap = loader.CapturedNet(net).eval()\n    dP, dV = cap.assert_equivalent(n=64)\n    with torch.no_grad():\n        for _ in range(10):\n            net(bb, me)\n        torch.cuda.synchronize()\n        t = time.perf_counter()\n        for _ in range(100):\n            net(bb, me)\n        torch.cuda.synchronize()\n        eager = (time.perf_counter() - t) / 100 * 1e6\n    gr = loader.GraphRunner(cap).capture(bb, me)\n    for _ in range(10):\n        gr.replay()\n    torch.cuda.synchronize()\n    t = time.perf_counter()\n    for _ in range(100):\n        gr.replay()\n    torch.cuda.synchronize()\n    graph = (time.perf_counter() - t) / 100 * 1e6\n    print(\"%-7s %-5s %-9.1e %10.1f %10.1f %7.2fx\" %\n          (tag, \"fp16\" if half else \"fp32\", dP, eager, graph, eager / graph))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T16:16:16.764208Z","iopub.execute_input":"2026-11-17T16:16:16.765258Z","iopub.status.idle":"2026-11-17T16:16:20.915833Z","shell.execute_reply.started":"2026-11-17T16:16:16.765234Z","shell.execute_rep