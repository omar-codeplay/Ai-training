CK)\ntotal_sims, total_time, games = 0, 0.0, 0\nfor g in range(10):\n    board = chess.Board()\n    hist = {chess.polyglot.zobrist_hash(board)}\n    for ply in range(80):\n        if board.is_game_over(claim_draw=True):\n            break\n        root = engine.make_root(board, net)\n        t0 = time.perf_counter()\n        engine.run_mcts(board, root, net, budget_sims=800, game_history_z=hist)\n        total_time += time.perf_counter() - t0\n        total_sims += root.N\n        mv = engine.choose_move(board, root, net, time_budget_s=0.0,\n                                game_history_z=hist)\n        if mv is None:\n            break\n        board.push(mv)\n        hist.add(chess.polyglot.zobrist_hash(board))\n    games += 1\n    print(\"  game %d done: sims=%d time=%.1fs\" % (g + 1, total_sims, total_time))\nnps = total_sims / total_time if total_time else 0.0\nprint(\"games=%d sims=%d time=%.1fs  nps=%.0f\" % (games, total_sims, total_time, nps))\njson.dump({\"nps\": nps, \"sims\": total_sims, \"seconds\": round(total_time, 1),\n           \"games\": games}, open(\"/kaggle/working/nps.json\", \"w\"), indent=2)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T16:16:22.853305Z","iopub.execute_input":"2026-11-17T16:16:22.853641Z","iopub.status.idle":"2026-11-17T16:23:54.18197Z","shell.execute_reply.started":"2026-11-17T16:16:22.85362Z","shell.execute_reply":"2026-11-17T16:23:54.181285Z"}},"outputs":[{"name":"stdout","text":"  game 1 done: sims=64379 time=62.7s\n  game 2 done: sims=128681 time=110.8s\n  game 3 done: sims=193068 time=169.3s\n  game 4 done: sims=257157 time=208.0s\n  game 5 done: sims=321309 time=251.8s\n  game 6 done: sims=385517 time=297.0s\n  game 7 done: sims=449668 time=337.2s\n  game 8 done: sims=513759 time=373.1s\n  game 9 done: sims=577847 time=408.3s\n  game 10 done: sims=641927 time=443.5s\ngames=10 sims=641927 time=443.5s  nps=1447\n","output_type":"stream"}],"execution_count":14},{"id":"c163a617-e16e-4578-92c0-9