 \"\\n\\nRespond with the JSON object only.\"\n    PROMPTS = [\n        \"Use ai-website, create /article.html and /styles/article.css.\",\n        \"Use ai-python, debug this error in /report.py: KeyError: 'total'.\",\n        \"Use ai-go, explain when defer runs and in what order.\",\n    ]\n    TIMING_RE = re.compile(\n        r\"llama_print_timings:\\s+([\\w\\s]*?time)\\s*=\\s*([\\d.]+)\\s*ms\\s*/\\s*(\\d+)\\s*runs\"\n        r\".*?\\(\\s*([\\d.]+)\\s*ms per token,\\s*([\\d.]+)\\s*tokens per second\\)\", re.S)\n\n    def run_cli(prompt, n_predict=96, reps=3):\n        cmd = [CLI, \"-m\", BEST, \"-p\", prompt + PROMPT_SUFFIX,\n               \"-n\", str(n_predict), \"-t\", \"4\", \"-ngl\", \"0\",\n               \"--no-warmup\", \"-fa\", \"0\", \"--temp\", \"0\",\n               \"-c\", \"512\", \"--no-display-prompt\"]\n        results, last_text = [], \"\"\n        for _ in range(reps):\n            t0 = time.perf_counter()\n            proc = subprocess.run(cmd, capture_output=True, text=True)\n            wall = time.perf_counter() - t0\n            last_text = proc.stdout\n            out = proc.stdout + proc.stderr\n            timings = {m.group(1).strip(): {\n                \"tok_per_s\": float(m.group(5)), \"runs\": int(m.group(3))\n            } for m in TIMING_RE.finditer(out)}\n            results.append({\"wall\": wall, \"timings\": timings,\n                            \"stderr\": proc.stderr[-400:]})\n        return results, last_text\n\n    print(\"=\" * 66)\n    print(\"B) llama-cli — latency (3 reps each)\")\n    print(\"=\" * 66)\n\n    def avg(xs):\n        xs = [x for x in xs if x is not None and x == x]\n        return sum(xs) / len(xs) if xs else float(\"nan\")\n\n    all_stats = []\n    for i, p in enumerate(PROMPTS, 1):\n        print(f\"\\n--- Prompt {i} ---\"); print(p[:90])\n        res, text = run_cli(p)\n        pp = [r[\"timings\"].get(\"prompt eval time\", {}).get(\"tok_per_s\") for r in res]\n        tg = [r[\"timings\"].get(\"ev