ckpt = torch.load(path, map_location=\"cpu\", weights_only=False)\n    return ckpt[\"config\"], ckpt[\"vocab\"], ckpt[\"model\"]\n\ndef build_token_list(vocab):\n    inv = {i: t for t, i in vocab.items()}\n    V = max(inv) + 1\n    tokens = [\"<unk>\"] * V\n    types  = [TT_UNKNOWN] * V\n    for name, tid in ((BOS, BOS_ID), (EOS, EOS_ID), (PAD, PAD_ID), (UNK, UNK_ID)):\n        tokens[tid] = name\n        types[tid]  = TT_CONTROL\n    for b in range(256):\n        tokens[BYTE_BASE + b] = chr(b)\n        types[BYTE_BASE + b]  = TT_BYTE\n    for t, i in vocab.items():\n        if i >= WORD_START:\n            tokens[i] = t\n            types[i]  = TT_NORMAL\n    return tokens, types\n\nTOP = [\n    (\"wte.weight\", \"token_embd.weight\"),\n    (\"wpe.weight\", \"position_embd.weight\"),\n    (\"ln.weight\",  \"output_norm.weight\"),\n    (\"ln.bias\",    \"output_norm.bias\"),\n]\nBLK = [\n    (\"blocks.{i}.ln1.weight\",      \"blk.{i}.attn_norm.weight\"),\n    (\"blocks.{i}.ln1.bias\",        \"blk.{i}.attn_norm.bias\"),\n    (\"blocks.{i}.ln2.weight\",      \"blk.{i}.ffn_norm.weight\"),\n    (\"blocks.{i}.ln2.bias\",        \"blk.{i}.ffn_norm.bias\"),\n    (\"blocks.{i}.attn.qkv.weight\", \"blk.{i}.attn_qkv.weight\"),\n    (\"blocks.{i}.attn.qkv.bias\",   \"blk.{i}.attn_qkv.bias\"),\n    (\"blocks.{i}.attn.o.weight\",   \"blk.{i}.attn_output.weight\"),\n    (\"blocks.{i}.attn.o.bias\",     \"blk.{i}.attn_output.bias\"),\n    (\"blocks.{i}.mlp.fc.weight\",   \"blk.{i}.ffn_up.weight\"),\n    (\"blocks.{i}.mlp.fc.bias\",     \"blk.{i}.ffn_up.bias\"),\n    (\"blocks.{i}.mlp.proj.weight\", \"blk.{i}.ffn_down.weight\"),\n    (\"blocks.{i}.mlp.proj.bias\",   \"blk.{i}.ffn_down.bias\"),\n]\n\ndef convert(pt_path, out_path, name=\"gpt10k\"):\n    cfg, vocab, state = load_ckpt(pt_path)\n    n_layer, n_head = cfg[\"n_layer\"], cfg[\"n_head\"]\n    n_embd, block   = cfg[\"n_embd\"],  cfg[\"block\"]\n\n    tokens, types = build_token_list(vocab)\n    V = len(tokens)\n    w = GGUFWriter(out_path, \"gpt2\")\n\n    w.add_name(name)\n    w.add_string(\"general.description\", \"custom GPT trained from scratch\")\n    w.add_uint32(\"general.file_type\", 1)          # F16\n\n    w.add_uint32(\"gpt2.context_length\",              block)\n    w.add_uint32(\"gpt2.embedding_length\",            n_embd)\n    w.add_uint32(\"gpt2.block_count\",                 n_layer)\n    w.add_uint32(\"gpt2.attention.head_count\",        n_head)\n    w.add_uint32(\"gpt2.attention.head_count_kv\",     n_head)\n    w.add_float32(\"gpt2.attention.layer_norm_epsilon\", 1e-5)\n    w.add_uint32(\"gpt2.feed_forward_length\",         4 * n_embd)\n    w.add_uint32(\"gpt2.vocab_size\",                  V)\n\n    w.add_string(\"tokenizer.ggml.model\", \"gpt2\")\n    w.add_array(\"tokenizer.ggml.tokens\", tokens)\n    w.add_array(\"tokenizer.ggml.token_type\", types)\n    w.add_uint32(\"tokenizer.ggml.bos_token_id\", BOS_ID)\n    w.add_uint32(\"tokenizer.ggml.eos_token_id\", EOS_ID)\n    w.add_uint32(\"tokenizer.ggml.padding_token_id\", PAD_ID)\n    w.add_uint32(\"tokenizer.ggml.unknown_token_id\", UNK_ID)\n    w.add_bool(\"tokenizer.ggml.add_bos_token\", True)\n    w.add_bool(\"tokenizer.ggml.add_eos_token\", True)\n    w.add_array(\"tokenizer.ggml.scores\", [0.0] * V)\n\n    written = set()\n    def emit(src, dst):\n        if src in state:\n            w.add_tensor(dst, state[src].to(torch.float16).numpy())\n            written.add(src)\n        else:\n            print(f\"[warn] missing {src}\")\n\n    for s, d in TOP:\n        emit(s, d)\n    for i in range(n_layer):\n        for s_t, d_t in BLK:\n            emit(s_t.format(i=i), d_t.format(i=i))\n\n    dropped = [k for k in state.keys() if k not in written]\n    if dropped:\n        print(f\"[info] dropped {len(dropped)} tensors (MTP heads etc): {dropped[:6]}...\")\n\n    w.write_header_to_file()\n    w.write_kv_data_to_file()\n    w.write_tensors_to_file()\n    w.close()\n    print(f\"[ok] {out_path}  ({os.path.getsize(out_path)/1e6:.1f} MB)\")\n    print(f\"     vocab={V} layers={n_layer} embd={n_embd} heads={n_head} ctx={block}\")\n\nif __name__ == \"__main__\":\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"pt\"); ap.add_argument(\"gguf\")\n    ap.add_argument(\"--name\", default=\"gpt10k\")\n    a = ap.parse_args()\n    convert(a.pt, a.gguf, a.name)\n'''\nwith open(\"/kaggle/working/pt_to_gguf.py\", \"w\") as f:\n    f.write(CONV)\n\n# ---------- 3. .pt -> F16 GGUF ----------\nsubprocess.run([sys.executable, \"/kaggle/working/pt_to_gguf.py\",\n                PT, \"/kaggle/working/gpt10k-f16.gguf\",\n                \"--name\", \"gpt10k\"], check=True)\n\n# ---------- 4. build llama.cpp (CPU only, fast) ----------\n!rm -rf /kaggle/working/llama.cpp\n!git clone --depth=1 https://github.com/ggerganov/llama.cpp /kaggle/working/llama.cpp\n!cmake -S /kaggle/working/llama.cpp -B /kaggle/working/llama.cpp/build \\\n    -DGGML_CUDA=OFF -DCMAKE_BUILD_TYPE=Release -DLLAMA_CURL=OFF \\\n    -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF\n!cmake --build /kaggle/working/llama.cpp/build --config Release -j4 --target llama-quantize\n\n# ---------- 5. quantize to Q4_K_M ----------\n! /kaggle/working/llama.cpp/build/bin/llama-quantize \\\n    /kaggle/working/gpt10k-f16.gguf \\\n    /kaggle/working/gpt10k-Q4_K_M.gguf \\\n    Q4_K_M\n\n# ---------- 6. results + download links ----------\nfrom IPython.display import FileLink, display\nprint(\"\\n=== GGUF files ===\")\nfor f in sorted(glob.glob(\"/kaggle/working/*.gguf\")):\n    print(f\"{os.path.basename(f):32s} {os.path.getsize(f)/1e6:6.2f} MB\")\n    display(FileLink(f))\nprint(\"\\nAlso visible in the Output tab after you 'Save Version'.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-10T11:42:57.692309Z","iopub.execute_input":"2026-10-10T11:42:57.692585Z","iopub.status.idle":"2026-10-10T11:47:02.783444Z","shell.execute_reply.started":"2026-10-10T11:42:57.69256Z","shell.execute_reply":"2026-10-10T11:47:02