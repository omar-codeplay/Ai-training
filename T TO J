ON object only.\"\n\ndef generate_and_decode(prompt, max_tokens=160):\n    \"\"\"Generate tokens one at a time, decode with our Python vocab.\"\"\"\n    input_ids = encode(prompt + PROMPT_SUFFIX)\n    llm.reset()\n    llm.eval(input_ids)\n\n    out_ids = []\n    t0 = time.perf_counter()\n    for _ in range(max_tokens):\n        tok = llm.sample(temp=0.0, top_k=0)   # greedy\n        if tok == llm.token_eos():\n            break\n        out_ids.append(tok)\n        llm.eval([tok])\n    wall = time.perf_counter() - t0\n    return decode(out_ids), out_ids, wall\n\n# ---- generate for each prompt ----\nPROMPTS = [\n    \"Use ai-website, create /article.html and /styles/article.css.\",\n    \"Use ai-python, debug this error in /report.py: KeyError: 'total'.\",\n    \"Use ai-go, explain when defer runs and in what order.\",\n]\n\nprint(\"=\" * 70)\nprint(\"Readable output via Python detokenizer\")\nprint(\"=\" * 70)\n\nfor i, p in enumerate(PROMPTS, 1):\n    text, ids, wall = generate_and_decode(p, max_tokens=160)\n    print(f\"\\n{'─'*70}\")\n    print(f\"PROMPT {i}: {p}\")\n    print(f\"{'─'*70}\")\n    print(text)\n    print(f\"\\n  [{len(ids)} tokens, {wall*1000:.0f} ms, \"\n          f\"{len(ids)/wall:.1f} tok/s]\")\n\n# ---- save the first one ----\ntext, ids, wall = generate_and_decode(PROMPTS[0], max_tokens=200)\nopen(\"/kaggle/working/readable_sample.txt\", \"w\").write(text)\ndisplay(FileLink(\"/kaggle/working/readable_sample.txt\"))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-10T12:28:17.47322Z","iopub.execute_input":"2026-10-10T12:28:17.473812Z","iopub.status.idle":"2026-10-10T12:28:18.039772Z","shell.execute_reply.started":"2026-10-10T12:28:17.473782Z","shell.execute_reply":"2026-10-10T12:28:18.039106Z"}},"outputs":[{"name":"stdout","text":"======================================================================\nReadable output via Python detokenizer\n======================================================================\n\n─────────