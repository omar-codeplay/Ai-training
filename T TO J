ll\", \"-q\", \"--upgrade\",\n                \"gguf\", \"huggingface_hub\"], check=True)\n\nfrom huggingface_hub import hf_hub_download\nfrom gguf import GGUFWriter, GGUFReader\n\nBOS, EOS, PAD, UNK = \"<bos>\", \"<eos>\", \"<pad>\", \"<unk>\"\nBOS_ID, EOS_ID, PAD_ID, UNK_ID = 0, 1, 2, 3\nBYTE_BASE, WORD_START = 4, 260\nTT_NORMAL = 1\n\ndef _bytes_to_unicode():\n    bs = (list(range(ord(\"!\"), ord(\"~\") + 1)) +\n          list(range(ord(\"¡\"), ord(\"¬\") + 1)) +\n          list(range(ord(\"®\"), ord(\"ÿ\") + 1)))\n    cs = bs[:]\n    n = 0\n    for b in range(256):\n        if b not in bs:\n            bs.append(b); cs.append(256 + n); n += 1\n    return dict(zip(bs, [chr(c) for c in cs]))\nB2U = _bytes_to_unicode()\n\n# ---------- 1. download ----------\nPT = hf_hub_download(repo_id=\"OmarCodePlay/Text-to-json\",\n                     filename=\"gpt10k.pt.step_9000\",\n                     local_dir=\"/kaggle/working\")\nprint(f\"[dl] {PT}  {os.path.getsize(PT)/1e6:.1f} MB\")\n\n# ---------- 2. load ----------\nckpt = torch.load(PT, map_location=\"cpu\", weights_only=False)\ncfg, vocab, state = ckpt[\"config\"], ckpt[\"vocab\"], ckpt[\"model\"]\nn_layer, n_head = cfg[\"n_layer\"], cfg[\"n_head\"]\nn_embd,  block  = cfg[\"n_embd\"],  cfg[\"block\"]\nprint(f\"[cfg] layers={n_layer} embd={n_embd} heads={n_head} ctx={block}\")\n\n# ---------- 3. token list ----------\ninv = {i: t for t, i in vocab.items()}\nV = max(inv) + 1\ntokens = [f\"<unused_{i}>\" for i in range(V)]\nttypes = [TT_NORMAL] * V\ntokens[BOS_ID] = \"<s>\"; tokens[EOS_ID] = \"</s>\"\ntokens[PAD_ID] = \"<pad>\"; tokens[UNK_ID] = \"<unk>\"\nfor b in range(256):\n    tokens[BYTE_BASE + b] = B2U[b]\nfor t, i in vocab.items():\n    if i >= WORD_START and t:\n        tokens[i] = t\nseen, dups = {}, 0\nfor i in range(V):\n    if tokens[i] in seen:\n        tokens[i] = f\"<dup_{i}>\"; dups += 1\n    else:\n        seen[tokens[i]] = i\nprint(f\"[tok] V={V}  resolved {dups} duplicates\")\n\n# ---------- 4. write F16 GGUF ----------\nF16 = \"/kaggle/working/gpt10k-f16.gguf\"\nif os.path.exists(F16): os.remove(F16)\n\nw = GGUFWriter(F16, \"gpt2\")\nw.add_name(\"gpt10k\")\nw.add_string(\"general.description\", \"custom GPT from scratch\")\nw.add_uint32(\"general.file_type\", 0)                    # 0 = all F32\nw.add_uint32(\"gpt2.context_length\",                 block)\nw.add_uint32(\"gpt2.embedding_length\",               n_embd)\nw.add_uint32(\"gpt2.block_count\",                    n_layer)\nw.add_uint32(\"gpt2.attention.head_count\",           n_head)\nw.add_uint32(\"gpt2.attention.head_count_kv\",        n_head)\nw.add_float32(\"gpt2.attention.layer_norm_epsilon\",  1e-5)\nw.add_uint32(\"gpt2.feed_forward_length\",            4 * n_embd)\nw.add_uint32(\"gpt2.vocab_size\",                     V)\nw.add_string(\"tokenizer.ggml.model\", \"gpt2\")\nw.add_string(\"tokenizer.ggml.pre\",   \"default\")\nw.add_array(\"tokenizer.ggml.tokens\",     tokens)\nw.add_array(\"tokenizer.ggml.token_type\", ttypes)\nw.add_array(\"tokenizer.ggml.scores\",     [0.0] * V)\nw.add_array(\"tokenizer.ggml.merges\",     [\"##\"])\nw.add_uint32(\"tokenizer.ggml.bos_token_id\",     BOS_ID)\nw.add_uint32(\"tokenizer.ggml.eos_token_id\",     EOS_ID)\nw.add_uint32(\"tokenizer.ggml.padding_token_id\", PAD_ID)\nw.add_uint32(\"tokenizer.ggml.unknown_token_id\", UNK_ID)\nw.add_bool(\"tokenizer.ggml.add_bos_token\", True)\nw.add_bool(\"tokenizer.ggml.add_eos_token\", True)\n\n# >>> KEY FIX: force all tensors to F32 <<<\ndef to_gguf(t):\n    return np.ascontiguousarray(t.to(torch.float32).numpy())\n\nTOP = [\n    (\"wte.weight\", \"token_embd.weight\"),\n    (\"wpe.weight\", \"position_embd.weight\"),\n    (\"ln.weight\",  \"output_norm.weight\"),\n    (\"ln.bias\",    \"output_norm.bias\"),\n]\nBLK = [\n    (\"blocks.{i}.ln1.weight\",      \"blk.{i}.attn_norm.weight\"),\n    (\"blocks.{i}.ln1.bias\",        \"blk.{i}.attn_norm.bias\"),\n    (\"blocks.{i}.ln2.weight\",      \"blk.{i}.ffn_norm.weight\"),\n    (\"blocks.{i}.ln2.bias\",        \"blk.{i}.ffn_norm.bias\"),\n    (\"blocks.{i}.attn.qkv.weight\", \"blk.{i}.attn_qkv.weight\"),\n    (\"blocks.{i}.attn.qkv.bias\",   \"blk.{i}.attn_qkv.bias\"),\n    (\"blocks.{i}.attn.o.weight\",   \"blk.{i}.attn_output.weight\"),\n    (\"blocks.{i}.attn.o.bias\",     \"blk.{i}.attn_output.bias\"),\n    (\"blocks.{i}.mlp.fc.weight\",   \"blk.{i}.ffn_up.weight\"),\n    (\"blocks.{i}.mlp.fc.bias\",     \"blk.{i}.ffn_up.bias\"),\n    (\"blocks.{i}.mlp.proj.weight\", \"blk.{i}.ffn_down.weight\"),\n    (\"blocks.{i}.mlp.proj.bias\",   \"blk.{i}.ffn_down.bias\"),\n]\nwritten = set()\ndef emit(src, dst):\n    if src in state:\n        w.add_tensor(dst, to_gguf(state[src]))\n        written.add(src)\n    else:\n        print(f\"[warn] missing {src}\")\n\nfor s, d in TOP: emit(s, d)\nfor i in range(n_layer):\n    for s_t, d_t in BLK:\n        emit(s_t.format(i=i), d_t.format(i=i))\n\ndropped = [k for k in state.keys() if k not in written]\nif dropped:\n    print(f\"[info] dropped {len(dropped)} tensors: {dropped[:6]}...\")\n\nw.write_header_to_file(); w.write_kv_data_to_file(); w.write_tensors_to_file(); w.close()\nprint(f\"[ok] {F16}  {os.path.getsize(F16)/1e6:.2f} MB\")\n\n# ---------- 5. build llama.cpp ----------\nif not os.path.isdir(\"/kaggle/working/llama.cpp\"):\n    subprocess.run(\"git clone --depth=1 https://github.com/ggerganov/llama.cpp \"\n                   \"/kaggle/working/llama.cpp\", shell=True, check=True)\nsubprocess.run(\n    \"cmake -S /kaggle/working/llama.cpp -B /kaggle/working/llama.cpp/build \"\n    \"-DGGML_CUDA=OFF -DCMAKE_BUILD_TYPE=Release -DLLAMA_CURL=OFF \"\n    \"-DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=ON\",\n    shell=True, check=True,\n    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\nsubprocess.run(\n    \"cmake --build /kaggle/working/llama.cpp/build --config Release \"\n    \"-j4 --target llama-quantize llama-bench llama-cli\",\n    shell=True, check=True,\n    stdout=subprocess.